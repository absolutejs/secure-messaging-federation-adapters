{
  "name": "@absolutejs/secure-messaging-federation-adapters",
  "private": true,
  "type": "module",
  "workspaces": [
    "delivery",
    "https",
    "mimi",
    "webcrypto"
  ],
  "scripts": {
    "build": "bun run --filter './*' build",
    "check:package": "bun run --filter './*' check:package",
